<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:id="@+id/videoLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerViewBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="zoom"
            app:show_buffering="never"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerViewFront"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="zoom"
            app:show_buffering="never"
            app:surface_type="texture_view"
            app:use_controller="false" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/chatTopGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.65" />

        <LinearLayout
            android:id="@+id/networkStatusPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#55000000"
            android:orientation="vertical"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvNetStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Status: Connected" />

            <TextView
                android:id="@+id/tvNetWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                tools:text="WIFI: MyWifi" />

            <TextView
                android:id="@+id/tvNetDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                tools:text="Down: 0.00 KB/s" />

            <TextView
                android:id="@+id/tvNetUpload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                tools:text="Up: 0.00 KB/s" />
        </LinearLayout>

        <androidx.camera.view.PreviewView
            android:id="@+id/previewFace"
            android:layout_width="110dp"
            android:layout_height="150dp"
            android:layout_marginTop="96dp"
            android:background="#44000000"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/chatPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#00000000"
            android:padding="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightButtonGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/chatTopGuide">

            <ScrollView
                android:id="@+id/svChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chatContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/rightButtonGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/btnStartListen"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle_action"
                android:text="@string/start_asr_short"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnTtsTest"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle_action"
                android:text="@string/settings_short"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnSwitchCharacter"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_circle_action"
                android:text="@string/switch_character_short"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnDeviceInfo"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_circle_action"
                android:text="@string/show_device_short"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
